<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sekai.learn.mapper.SekaiLearnSubjectMapper">

    <resultMap id="SubjectResultMap" type="com.sekai.learn.dataobject.SekaiLearnSubjectDO">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="icon" property="icon"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="findAll" resultMap="SubjectResultMap">
        SELECT * FROM sekai_learning_subjects ORDER BY sort_order
    </select>

    <select id="findById" resultMap="SubjectResultMap">
        SELECT * FROM sekai_learning_subjects WHERE id = #{id}
    </select>

</mapper>
