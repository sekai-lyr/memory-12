<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sekai.learn.mapper.SekaiLearnResourceMapper">

    <resultMap id="ResourceResultMap" type="com.sekai.learn.dataobject.SekaiLearnResourceDO">
        <id column="id" property="id"/>
        <result column="course_id" property="courseId"/>
        <result column="title" property="title"/>
        <result column="url" property="url"/>
        <result column="cover_url" property="coverUrl"/>
        <result column="author" property="author"/>
        <result column="author_url" property="authorUrl"/>
        <result column="play_count" property="playCount"/>
        <result column="duration" property="duration"/>
        <result column="description" property="description"/>
        <result column="source_type" property="sourceType"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="enabled" property="enabled"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="findByCourseId" resultMap="ResourceResultMap">
        SELECT * FROM sekai_learning_resources
        WHERE course_id = #{courseId} AND enabled = TRUE
        ORDER BY sort_order, id
    </select>

    <select id="findById" resultMap="ResourceResultMap">
        SELECT * FROM sekai_learning_resources WHERE id = #{id}
    </select>

</mapper>
