<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sekai.learn.mapper.SekaiLearnPaperMapper">

    <resultMap id="PaperResultMap" type="com.sekai.learn.dataobject.SekaiLearnPaperDO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="title" property="title"/>
        <result column="original_filename" property="originalFilename"/>
        <result column="file_path" property="filePath"/>
        <result column="file_type" property="fileType"/>
        <result column="content_text" property="contentText"/>
        <result column="summary" property="summary"/>
        <result column="chapters_json" property="chaptersJson"/>
        <result column="character_id" property="characterId"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="findById" resultMap="PaperResultMap">
        SELECT * FROM sekai_learning_papers WHERE id = #{id}
    </select>

    <select id="findByUserId" resultMap="PaperResultMap">
        SELECT * FROM sekai_learning_papers WHERE user_id = #{userId} ORDER BY created_at DESC
    </select>

    <insert id="insert" parameterType="com.sekai.learn.dataobject.SekaiLearnPaperDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sekai_learning_papers (user_id, title, original_filename, file_path, file_type,
            content_text, summary, chapters_json, character_id, status, created_at, updated_at)
        VALUES (#{userId}, #{title}, #{originalFilename}, #{filePath}, #{fileType},
            #{contentText}, #{summary}, #{chaptersJson}, #{characterId}, #{status}, NOW(), NOW())
    </insert>

    <update id="update" parameterType="com.sekai.learn.dataobject.SekaiLearnPaperDO">
        UPDATE sekai_learning_papers
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="summary != null">summary = #{summary},</if>
            <if test="chaptersJson != null">chapters_json = #{chaptersJson},</if>
            <if test="characterId != null">character_id = #{characterId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="contentText != null">content_text = #{contentText},</if>
            updated_at = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sekai_learning_papers WHERE id = #{id}
    </delete>

    <select id="countByUserId" resultType="int">
        SELECT COUNT(*) FROM sekai_learning_papers WHERE user_id = #{userId}
    </select>

</mapper>
