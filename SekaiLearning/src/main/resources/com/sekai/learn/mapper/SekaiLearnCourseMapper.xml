<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sekai.learn.mapper.SekaiLearnCourseMapper">

    <resultMap id="CourseResultMap" type="com.sekai.learn.dataobject.SekaiLearnCourseDO">
        <id column="id" property="id"/>
        <result column="subject_id" property="subjectId"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="difficulty" property="difficulty"/>
        <result column="estimated_hours" property="estimatedHours"/>
        <result column="lesson_count" property="lessonCount"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="findBySubjectId" resultMap="CourseResultMap">
        SELECT * FROM sekai_learning_courses WHERE subject_id = #{subjectId} ORDER BY sort_order
    </select>

    <select id="findById" resultMap="CourseResultMap">
        SELECT * FROM sekai_learning_courses WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="CourseResultMap">
        SELECT * FROM sekai_learning_courses ORDER BY sort_order
    </select>

</mapper>
