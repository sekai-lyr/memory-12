<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sekai.learn.mapper.SekaiLearnCoinLogMapper">

    <resultMap id="CoinLogResultMap" type="com.sekai.learn.dataobject.SekaiLearnCoinLogDO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="amount" property="amount"/>
        <result column="reason" property="reason"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="findByUserId" resultMap="CoinLogResultMap">
        SELECT * FROM sekai_learning_coin_logs WHERE user_id = #{userId} ORDER BY created_at DESC LIMIT 50
    </select>

    <insert id="insert" parameterType="com.sekai.learn.dataobject.SekaiLearnCoinLogDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sekai_learning_coin_logs (user_id, amount, reason, created_at)
        VALUES (#{userId}, #{amount}, #{reason}, NOW())
    </insert>

</mapper>
