<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sekai.learn.mapper.SekaiLearnAchievementMapper">

    <resultMap id="AchievementResultMap" type="com.sekai.learn.model.Achievement">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="icon" property="icon"/>
        <result column="category" property="category"/>
        <result column="required_value" property="requiredValue"/>
        <result column="reward_coins" property="rewardCoins"/>
        <result column="enabled" property="enabled"/>
    </resultMap>

    <resultMap id="UserAchievementResultMap" type="com.sekai.learn.dataobject.SekaiLearnUserAchievementDO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="achievement_id" property="achievementId"/>
        <result column="unlocked_at" property="unlockedAt"/>
    </resultMap>

    <select id="findAllEnabled" resultMap="AchievementResultMap">
        SELECT * FROM sekai_learning_achievements WHERE enabled = TRUE
    </select>

    <select id="findById" resultMap="AchievementResultMap">
        SELECT * FROM sekai_learning_achievements WHERE id = #{id}
    </select>

    <select id="findByUserId" resultMap="UserAchievementResultMap">
        SELECT * FROM sekai_learning_user_achievements WHERE user_id = #{userId}
    </select>

    <insert id="insertUserAchievement" parameterType="com.sekai.learn.dataobject.SekaiLearnUserAchievementDO">
        INSERT INTO sekai_learning_user_achievements (user_id, achievement_id, unlocked_at)
        VALUES (#{userId}, #{achievementId}, NOW())
    </insert>

    <select id="existsByUserIdAndAchievementId" resultType="int">
        SELECT COUNT(*) FROM sekai_learning_user_achievements WHERE user_id = #{userId} AND achievement_id = #{achievementId}
    </select>

</mapper>
